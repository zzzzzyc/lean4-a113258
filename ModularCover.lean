private theorem append_checked {xs ys : List CertifiedModCertRow}
    (hx : xs.all (fun r => rowCheck r.row) = true)
    (hy : ys.all (fun r => rowCheck r.row) = true) :
    (xs ++ ys).all (fun r => rowCheck r.row) = true := by
  rw [List.all_append, hx, hy]
  rfl

